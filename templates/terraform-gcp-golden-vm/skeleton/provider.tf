terraform {
  backend "gcs" {
    bucket  = "terraform-backstage-state"
    prefix  = "golden-vm"
  }

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 4.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}